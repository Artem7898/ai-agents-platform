{
	admin off
	auto_https disable_redirects
	http_port 8080
	https_port 8443
}

# Public ACME TLS requires a real hostname and inbound ports 80 and 443.
https://{$GGUF_HOSTNAME}:8443 {
	request_body {
		max_size 2MB
	}
	@models {
		method GET
		path /v1/models
	}
	@completion {
		method POST
		path /v1/chat/completions
	}
	route {
		reverse_proxy @models llama:8080
		reverse_proxy @completion llama:8080 {
			flush_interval -1
			transport http {
				dial_timeout 5s
				response_header_timeout 300s
				read_timeout 300s
				write_timeout 300s
			}
		}
		respond 404
	}
}
