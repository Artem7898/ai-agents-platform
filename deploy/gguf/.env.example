# Paths must point to existing, private host files. No weights are downloaded.
GGUF_MODEL_DIR=/absolute/path/to/model-directory
GGUF_API_KEY_FILE=/absolute/path/to/private/gguf-api-keys
# Use a new alias/deployment when replacing weights; retain the model SHA report.
GGUF_MODEL_ALIAS=qwen-pilot-v1
GGUF_CONTEXT_SIZE=4096
GGUF_MAX_OUTPUT_TOKENS=1024
GGUF_THREADS=4
GGUF_CPU_LIMIT=4
GGUF_MEMORY_LIMIT=8g
# Set these to `id -u` and `id -g` when the key file is owned by your host user.
GGUF_UID=10001
GGUF_GID=10001
# Default binds only loopback and uses Caddy's local CA; trust its exported root.
GGUF_HOSTNAME=localhost
GGUF_BIND_ADDRESS=127.0.0.1
GGUF_HTTPS_PORT=8443
# For compose.cloud.yaml, explicitly set real public DNS, 0.0.0.0 and port 443.
