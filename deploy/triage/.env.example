# Copy into an ignored .env file, or set these variables in your current shell.
DJANGO_SETTINGS_MODULE=config.settings.dev_postgres
DATABASE_URL=postgresql://triage:local-triage-only@127.0.0.1:55433/triage
LLM_ALLOWED_BASE_URLS=["http://127.0.0.1:11435/v1"]
OUTBOX_LEASE_SECONDS=15
DEMO_TRIAGE_ENABLED=true
DEMO_TRIAGE_SINK_URL=http://127.0.0.1:8010/api/demo/triage/sink/
# Supply a fresh local shared token; it is never written into evidence.
DEMO_TRIAGE_SINK_TOKEN=replace-with-a-fresh-local-demo-token
ALLOWED_HOSTS=["localhost","127.0.0.1"]
