# Local development only. Keep real credentials outside version control.
DJANGO_SETTINGS_MODULE=config.settings.dev_postgres
DATABASE_URL=postgresql://agents:local-development-only@127.0.0.1:5432/agents
ALLOWED_HOSTS=["localhost","127.0.0.1"]
CORS_ALLOWED_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO
# Required only for real LLM requests; tests use mocks.
OPENAI_API_KEY=
# Optional endpoint for agents without runtime_id (the legacy global client).
# OPENAI_BASE_URL=https://api.openai.com/v1
# Managed runtimes: exact endpoint allowlist and server-only alias -> key mapping.
# Both values are JSON; keep real LLM_RUNTIME_SECRETS values outside Git.
LLM_ALLOWED_BASE_URLS=["https://api.openai.com/v1"]
LLM_RUNTIME_SECRETS={}
# Each explicit binding selects its own external backend; no fallback on errors.
LLM_SECRET_BINDINGS={}
LLM_SECRET_CACHE_TTL_SECONDS=30
LLM_SECRET_CACHE_MAX_ENTRIES=128
LLM_SECRET_TIMEOUT_SECONDS=5
# Vault KV v2: use an HTTPS address and a token supplied by a protected file.
# LLM_VAULT_URL=https://vault.example.com
# LLM_VAULT_MOUNT=secret
# LLM_VAULT_TOKEN_FILE=/run/secrets/vault-token
# LLM_VAULT_NAMESPACE=team
# AWS uses its SDK credential chain; GCP uses Application Default Credentials.
# LLM_AWS_REGION=eu-central-1
# LLM_GCP_PROJECT=123456789012
# GCP project selection uses the numeric project number.
# See docs/secret-manager.md for all three binding formats and rotation steps.
# Example allowlist for a separately configured Ollama Compose service:
# LLM_ALLOWED_BASE_URLS=["https://api.openai.com/v1","http://ollama:11434/v1"]
# See docs/llm-runtimes.md before exposing an endpoint or assigning runtimes.
# Optional trusted search endpoint; search is disabled when unset.
KNOWLEDGE_BASE_SEARCH_URL=
# Production requires a generated SECRET_KEY, PostgreSQL and explicit hostnames.
# Use DJANGO_SETTINGS_MODULE=config.settings.prod with your secret manager.

# Durable worker leases and retry limit.
OUTBOX_LEASE_SECONDS=600
OUTBOX_MAX_ATTEMPTS=3

# Workflow LLM attempts are metered separately, including transport retries.
LLM_TRANSPORT_MAX_RETRIES=2
LLM_RETRY_BASE_SECONDS=0.25
LLM_RESERVATION_OVERHEAD_TOKENS=512
# Create owner quota policies through the staff API; see docs/llm-usage.md.

# Provider-neutral subscription ledger. Configure tariffs before enabling.
# Test and live accounts are isolated; no processor or automatic charge is configured.
BILLING_ENABLED=false
BILLING_MODE=test
# See docs/subscriptions-billing.md for manual payment evidence and capped overage.
